{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schmastore.example.com/ci-pipeline/2.0.0.json",
  "title": "PipelineConfig",
  "description": "Breaking: stages replaced by a job DAG; steps can be shell commands or reusable actions.",
  "type": "object",
  "required": ["version", "name", "jobs"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "name": { "type": "string" },
    "on": {
      "type": "object",
      "properties": {
        "push": { "$ref": "#/$defs/refFilter" },
        "pullRequest": { "$ref": "#/$defs/refFilter" },
        "schedule": { "type": "array", "items": { "type": "string" } },
        "manual": { "type": "boolean" }
      }
    },
    "variables": { "type": "object", "additionalProperties": { "$ref": "#/$defs/variable" } },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "refFilter": {
      "type": "object",
      "properties": {
        "branches": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } },
        "ignorePaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "variable": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["secret"],
          "properties": { "secret": { "type": "string" } },
          "additionalProperties": false
        }
      ]
    },
    "job": {
      "type": "object",
      "required": ["runsOn", "steps"],
      "properties": {
        "runsOn": { "enum": ["linux", "macos", "windows"] },
        "needs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "strategy": {
          "type": "object",
          "properties": {
            "matrix": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1 } },
            "failFast": { "type": "boolean", "default": true }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["run"],
                "properties": { "run": { "type": "string" }, "shell": { "enum": ["bash", "sh", "pwsh"] } }
              },
              {
                "type": "object",
                "required": ["uses"],
                "properties": {
                  "uses": { "type": "string", "pattern": "^[\\w-]+/[\\w-]+@[\\w.-]+$" },
                  "with": { "type": "object" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
