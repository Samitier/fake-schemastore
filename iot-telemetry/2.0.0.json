{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schmastore.example.com/iot-telemetry/2.0.0.json",
  "title": "TelemetryBatch",
  "description": "Breaking: batched, sensor-typed measurements with units and quality flags.",
  "type": "object",
  "required": ["deviceId", "batchId", "measurements"],
  "properties": {
    "deviceId": { "type": "string", "pattern": "^dev-[0-9a-f]{8}$" },
    "batchId": { "type": "string", "format": "uuid" },
    "firmware": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$" },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["sensor", "ts", "value", "unit"],
        "properties": {
          "sensor": { "enum": ["temperature", "humidity", "pressure", "co2", "motion"] },
          "ts": { "type": "integer", "description": "Unix epoch milliseconds" },
          "value": { "type": ["number", "boolean"] },
          "unit": { "enum": ["C", "F", "pct", "hPa", "ppm", "bool"] },
          "quality": { "enum": ["good", "uncertain", "bad"], "default": "good" }
        },
        "allOf": [
          {
            "if": { "properties": { "sensor": { "const": "motion" } } },
            "then": { "properties": { "value": { "type": "boolean" }, "unit": { "const": "bool" } } },
            "else": { "properties": { "value": { "type": "number" } } }
          }
        ]
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "uptimeS": { "type": "integer", "minimum": 0 },
        "rssiDbm": { "type": "integer", "maximum": 0 },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
          }
        }
      }
    }
  }
}
