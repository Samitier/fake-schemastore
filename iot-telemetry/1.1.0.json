{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schmastore.example.com/iot-telemetry/1.1.0.json",
  "title": "TelemetryReading",
  "type": "object",
  "required": ["deviceId", "timestamp", "readings"],
  "properties": {
    "deviceId": { "type": "string", "pattern": "^dev-[0-9a-f]{8}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "firmware": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "location": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitudeM": { "type": "number" }
      }
    },
    "readings": {
      "type": "object",
      "properties": {
        "temperatureC": { "type": "number", "minimum": -90, "maximum": 150 },
        "humidityPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "pressureHpa": { "type": "number", "minimum": 300, "maximum": 1100 },
        "co2Ppm": { "type": "integer", "minimum": 0 }
      },
      "minProperties": 1
    },
    "battery": {
      "type": "object",
      "properties": {
        "levelPct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "charging": { "type": "boolean" }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
