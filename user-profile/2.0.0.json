{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schmastore.example.com/user-profile/2.0.0.json",
  "title": "UserProfile",
  "description": "Adds account types, multiple emails, GDPR consent and conditional business fields.",
  "type": "object",
  "required": ["userId", "emails", "displayName", "accountType", "consents"],
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "displayName": { "type": "string", "minLength": 2, "maxLength": 50 },
    "accountType": { "enum": ["personal", "business"] },
    "emails": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["address", "verified"],
        "properties": {
          "address": { "type": "string", "format": "email" },
          "verified": { "type": "boolean" },
          "primary": { "type": "boolean", "default": false }
        }
      }
    },
    "consents": {
      "type": "object",
      "required": ["terms", "marketing"],
      "properties": {
        "terms": {
          "type": "object",
          "required": ["version", "acceptedAt"],
          "properties": {
            "version": { "type": "string" },
            "acceptedAt": { "type": "string", "format": "date-time" }
          }
        },
        "marketing": { "type": "boolean" },
        "analytics": { "type": "boolean", "default": false }
      }
    },
    "company": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "vatId": { "type": "string" },
        "size": { "enum": ["1-10", "11-50", "51-250", "250+"] }
      }
    }
  },
  "if": { "properties": { "accountType": { "const": "business" } } },
  "then": { "required": ["company"], "properties": { "company": { "required": ["name", "vatId"] } } },
  "else": { "not": { "required": ["company"] } }
}
